From fd684780bfcf7afa90409a13c568618c9ec0b582 Mon Sep 17 00:00:00 2001
From: Brian <bwallen@gmail.com>
Date: Wed, 30 Sep 2026 22:46:11 -0400
Subject: [PATCH] Check for a valid hash when uploading a data package


Blindside: fullmatch instead of upstream match; match only anchors the start,
so "<64 hex>/../../x" still reached os.path.join in save_data_package_file.
---
 .../blueprints/marti_api/data_package_marti_api.py          | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/opentakserver/blueprints/marti_api/data_package_marti_api.py b/opentakserver/blueprints/marti_api/data_package_marti_api.py
index 09ef52c1..7a7260f8 100644
--- a/opentakserver/blueprints/marti_api/data_package_marti_api.py
+++ b/opentakserver/blueprints/marti_api/data_package_marti_api.py
@@ -1,6 +1,7 @@
 import hashlib
 import io
 import os
+import re
 import traceback
 import uuid
 import zipfile
@@ -208,6 +209,11 @@ def data_package_share():
         if extension != "zip":
             file_hash = create_data_package_zip(file)
         else:
+            sha256_regex = re.compile("[A-Fa-f0-9]{64}")
+            if request.args.get("hash") and not sha256_regex.fullmatch(request.args.get("hash", "")):
+                logger.warning(f"Invalid file hash: {request.args.get('hash')}")
+                return jsonify({"success": False, "error": gettext("Invalid file hash")}), 400
+
             file_hash = save_data_package_file(file)
 
         url = urlparse(request.url_root)
